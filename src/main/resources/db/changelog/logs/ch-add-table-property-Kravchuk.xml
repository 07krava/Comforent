<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1-create-table-property" author="kravchuk">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="property"/>
            </not>
        </preConditions>

        <createTable tableName="property">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="special_price" type="DECIMAL(19,2)"/>

            <column name="start_date" type="DATE"/>

            <column name="end_date" type="DATE"/>
        </createTable>

        <!-- связь 1:1 с housing -->
        <addForeignKeyConstraint
                baseTableName="property"
                baseColumnNames="id"
                constraintName="fk_property_housing"
                referencedTableName="housing"
                referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>